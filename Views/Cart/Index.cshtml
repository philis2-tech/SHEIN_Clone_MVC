@model List<SHEIN_Clone_MVC.Models.CartItem>

@{
    ViewData["Title"] = "Shopping Cart";

    var subtotal = Model.Sum(item => item.Total);
}

<style>
    /* CART PAGE */
    .cart-page {
        max-width: 1200px;
        margin: 40px auto;
        padding: 0 20px 50px;
    }

    .cart-heading {
        font-size: 32px;
        font-weight: 700;
        margin-bottom: 8px;
    }

    .cart-subheading {
        color: #777;
        margin-bottom: 30px;
    }

    /* CART ITEMS */
    .cart-item {
        display: flex;
        align-items: center;
        gap: 20px;
        padding: 22px 0;
        border-bottom: 1px solid #e5e5e5;
    }

    .cart-product-image {
        width: 120px;
        height: 145px;
        object-fit: cover;
        border-radius: 5px;
        background: #f5f5f5;
        flex-shrink: 0;
    }

    .cart-product-placeholder {
        width: 120px;
        height: 145px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f5f5f5;
        color: #888;
        flex-shrink: 0;
    }

    .cart-product-info {
        flex: 1;
        min-width: 0;
    }

    .cart-product-name {
        font-size: 17px;
        font-weight: 600;
        color: #222;
        margin-bottom: 10px;
    }

    .cart-product-option {
        font-size: 14px;
        color: #777;
        margin-bottom: 5px;
    }

    .cart-product-price {
        font-weight: 600;
        margin-top: 12px;
    }

    /* QUANTITY CONTROLS */
    .quantity-control {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-top: 15px;
    }

    .quantity-btn {
        display: inline-flex;
        width: 32px;
        height: 32px;
        align-items: center;
        justify-content: center;
        border: 1px solid #ccc;
        border-radius: 4px;
        color: #222;
        background: white;
        text-decoration: none;
        font-size: 18px;
        transition: .2s;
    }

        .quantity-btn:hover {
            background: #222;
            color: white;
            border-color: #222;
        }

    .quantity-number {
        min-width: 18px;
        text-align: center;
    }

    /* ITEM TOTAL */
    .cart-item-total {
        min-width: 110px;
        text-align: right;
        font-weight: 600;
    }

    /* REMOVE BUTTON */
    .remove-item {
        display: inline-block;
        margin-top: 12px;
        color: #d63355;
        font-size: 13px;
        text-decoration: underline;
    }

        .remove-item:hover {
            color: #a71d38;
        }

    /* CART SUMMARY */
    .cart-summary {
        max-width: 420px;
        margin: 35px 0 0 auto;
        padding: 25px;
        border: 1px solid #e5e5e5;
        border-radius: 8px;
        background: #fff;
    }

    .summary-row {
        display: flex;
        justify-content: space-between;
        gap: 15px;
        margin-bottom: 18px;
    }

    .summary-total {
        border-top: 1px solid #ddd;
        padding-top: 18px;
        font-size: 20px;
        font-weight: 700;
    }

    .checkout-btn {
        display: block;
        width: 100%;
        padding: 14px;
        margin-top: 20px;
        background: #222;
        color: white;
        border: 1px solid #222;
        border-radius: 4px;
        text-align: center;
        text-decoration: none;
        font-weight: 600;
        transition: .2s;
    }

        .checkout-btn:hover {
            background: #444;
            color: white;
        }

    .continue-shopping {
        display: inline-block;
        margin-top: 20px;
        color: #222;
        text-decoration: underline;
    }

    /* EMPTY CART */
    .empty-cart {
        text-align: center;
        padding: 70px 20px;
        background: #fafafa;
        border-radius: 8px;
    }

    .empty-cart-icon {
        font-size: 55px;
        margin-bottom: 15px;
    }

    .empty-cart h3 {
        font-weight: 700;
        margin-bottom: 12px;
    }

    .shop-now-btn {
        display: inline-block;
        margin-top: 15px;
        padding: 12px 30px;
        background: #222;
        color: white;
        text-decoration: none;
        border-radius: 4px;
    }

        .shop-now-btn:hover {
            background: #444;
            color: white;
        }

    /* MOBILE RESPONSIVENESS */
    @@media (max-width: 768px) {

        .cart-page {
            margin-top: 25px;
            padding: 0 15px 35px;
        }

        .cart-heading {
            font-size: 27px;
        }

        .cart-item {
            align-items: flex-start;
            gap: 12px;
            flex-wrap: wrap;
        }

        .cart-product-image,
        .cart-product-placeholder {
            width: 90px;
            height: 115px;
        }

        .cart-product-info {
            flex: 1;
        }

        .cart-product-name {
            font-size: 15px;
        }

        .cart-item-total {
            width: 100%;
            text-align: left;
            padding-left: 102px;
        }

        .cart-summary {
            max-width: none;
            padding: 20px;
        }
    }
</style>


<div class="cart-page">

    <!-- PAGE HEADING -->

    <h1 class="cart-heading">
        Shopping Bag
    </h1>

    <p class="cart-subheading">
        Review your fashion picks before checking out.
    </p>


    @if (!Model.Any())
    {
        <!-- EMPTY CART -->

        <div class="empty-cart">

            <div class="empty-cart-icon">
                🛍️
            </div>

            <h3>Your shopping bag is empty</h3>

            <p class="text-muted">
                Looks like you haven't added anything yet.
                Discover something you love!
            </p>

            <a asp-controller="Products"
               asp-action="Index"
               class="shop-now-btn">

                Start Shopping

            </a>

        </div>
    }
    else
    {
        <!-- CART ITEMS -->

        <div class="cart-items">

            @foreach (var item in Model)
            {
                <div class="cart-item">

                    <!-- PRODUCT IMAGE -->
                    @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                    {
                        <img src="@item.ImageUrl"
                             alt="@item.ProductName"
                             class="cart-product-image" />
                    }
                    else
                    {
                        <div class="cart-product-placeholder">
                            No Image
                        </div>
                    }


                    <!-- PRODUCT INFORMATION -->

                    <div class="cart-product-info">

                        <h2 class="cart-product-name">
                            @item.ProductName
                        </h2>


                        @if (!string.IsNullOrWhiteSpace(item.Size))
                        {
                            <p class="cart-product-option">
                                Size: @item.Size
                            </p>
                        }


                        @if (!string.IsNullOrWhiteSpace(item.Color))
                        {
                            <p class="cart-product-option">
                                Colour: @item.Color
                            </p>
                        }


                        <p class="cart-product-price">
                            @item.Price.ToString("C")
                        </p>


                        <!-- QUANTITY CONTROLS -->

                        <div class="quantity-control">

                            <a asp-controller="Cart"
                               asp-action="DecreaseQuantity"
                               asp-route-id="@item.ProductId"
                               asp-route-size="@item.Size"
                               asp-route-color="@item.Color"
                               class="quantity-btn"
                               aria-label="Decrease quantity">

                                −

                            </a>


                            <span class="quantity-number">
                                @item.Quantity
                            </span>


                            <a asp-controller="Cart"
                               asp-action="IncreaseQuantity"
                               asp-route-id="@item.ProductId"
                               asp-route-size="@item.Size"
                               asp-route-color="@item.Color"
                               class="quantity-btn"
                               aria-label="Increase quantity">

                                +

                            </a>

                        </div>


                        <!-- REMOVE ITEM -->

                        <a asp-controller="Cart"
                           asp-action="RemoveFromCart"
                           asp-route-id="@item.ProductId"
                           asp-route-size="@item.Size"
                           asp-route-color="@item.Color"
                           class="remove-item">

                            Remove

                        </a>

                    </div>


                    <!-- ITEM TOTAL -->

                    <div class="cart-item-total">

                        @item.Total.ToString("C")

                    </div>

                </div>
            }

        </div>


        <!-- CART SUMMARY -->

        <div class="cart-summary">

            <h3 class="fw-bold mb-4">
                Order Summary
            </h3>


            <div class="summary-row">

                <span>
                    Subtotal
                </span>

                <span>
                    @subtotal.ToString("C")
                </span>

            </div>


            <div class="summary-row">

                <span>
                    Delivery
                </span>

                <span>
                    Calculated at checkout
                </span>

            </div>


            <div class="summary-row summary-total">

                <span>
                    Total
                </span>

                <span>
                    @subtotal.ToString("C")
                </span>

            </div>


            <!-- CHECKOUT PLACEHOLDER -->

            <a href="#"
               class="checkout-btn"
               onclick="alert('Checkout has not been implemented yet.'); return false;">

                PROCEED TO CHECKOUT

            </a>


            <div class="text-center">

                <a asp-controller="Products"
                   asp-action="Index"
                   class="continue-shopping">

                    Continue Shopping

                </a>

            </div>

        </div>
    }

</div>