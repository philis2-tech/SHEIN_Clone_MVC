@using SHEIN_Clone_MVC.Helpers

@{
    int cartCount = CartHelper.GetCartCount(Context);
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - SHEIN Style</title>

    <!-- BOOTSTRAP -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <!-- BOOTSTRAP ICONS -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- SITE CSS -->
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <!-- RAZOR CSS -->
    <link rel="stylesheet"
          href="~/SHEIN_Clone_MVC.styles.css"
          asp-append-version="true" />

</head>

<body>

    <!-- ============================= -->
    <!-- HEADER -->
    <!-- ============================= -->

    <header class="fashion-header">

        <!-- TOP HEADER -->

        <div class="fashion-topbar">

            <div class="fashion-topbar-inner">

                <!-- LOGO -->

                <a asp-controller="Home"
                   asp-action="Index"
                   class="fashion-logo">

                    SHEIN<span class="logo-divider">|</span><span class="logo-style">STYLE</span>

                </a>


                <!-- SEARCH BAR -->

                <form asp-controller="Products"
                      asp-action="Index"
                      method="get"
                      class="fashion-search">

                    <input type="text"
                           name="searchString"
                           placeholder="Search your next favourite look..."
                           aria-label="Search products" />

                    <button type="submit" aria-label="Search">

                        <i class="bi bi-search"></i>

                    </button>

                </form>


                <!-- HEADER ACTIONS -->

                <div class="fashion-actions">

                    <!-- HOME -->

                    <a asp-controller="Home"
                       asp-action="Index"
                       class="header-action"
                       title="Home">

                        <i class="bi bi-house-door"></i>

                        <span>Home</span>

                    </a>


                    <!-- SHOPPING BAG -->

                    <a asp-controller="Cart"
                       asp-action="Index"
                       class="header-action cart-action"
                       title="Shopping Bag">

                        <span class="cart-icon-wrapper">

                            <i class="bi bi-bag"></i>

                            @if (cartCount > 0)
                            {
                                <span class="cart-count">
                                    @cartCount
                                </span>
                            }

                        </span>

                        <span>Bag</span>

                    </a>

                </div>

            </div>

        </div>


        <!-- ============================= -->
        <!-- CATEGORY NAVIGATION -->
        <!-- ============================= -->

        <div class="fashion-category-bar">

            <nav class="fashion-category-nav"
                 aria-label="Product navigation">


                <!-- CATEGORIES MEGA MENU -->

                <div class="mega-menu-container">

                    <button type="button"
                            class="category-nav-link mega-menu-trigger"
                            id="megaMenuTrigger"
                            aria-expanded="false"
                            aria-controls="categoryMegaMenu">

                        Categories

                        <i class="bi bi-chevron-down"></i>

                    </button>

                    @await Component.InvokeAsync("CategoryMegaMenu")

                </div>


                <!-- NEW IN -->

                <a asp-controller="Products"
                   asp-action="Index"
                   class="category-nav-link category-new">

                    NEW IN

                </a>


                <!-- WOMEN -->

                <a asp-controller="Products"
                   asp-action="Index"
                   asp-route-categoryId="1"
                   class="category-nav-link">

                    Women Clothing

                </a>


                <!-- MEN -->

                <a asp-controller="Products"
                   asp-action="Index"
                   asp-route-categoryId="2"
                   class="category-nav-link">

                    Men Clothing

                </a>


                <!-- KIDS -->

                <a asp-controller="Products"
                   asp-action="Index"
                   asp-route-categoryId="3"
                   class="category-nav-link">

                    Kids

                </a>


                <!-- SHOES -->

                <a asp-controller="Products"
                   asp-action="Index"
                   asp-route-categoryId="4"
                   class="category-nav-link">

                    Shoes

                </a>


                <!-- ACTIVEWEAR -->

                <a asp-controller="Products"
                   asp-action="Index"
                   asp-route-categoryId="7"
                   class="category-nav-link">

                    Activewear

                </a>


                <!-- JEWELLERY -->

                <a asp-controller="Products"
                   asp-action="Index"
                   asp-route-categoryId="8"
                   class="category-nav-link">

                    Jewellery &amp; Accessories

                </a>


                <!-- BAGS -->

                <a asp-controller="Products"
                   asp-action="Index"
                   asp-route-categoryId="9"
                   class="category-nav-link">

                    Bags

                </a>


                <!-- BEACHWEAR -->

                <a asp-controller="Products"
                   asp-action="Index"
                   asp-route-categoryId="5"
                   class="category-nav-link">

                    Beachwear

                </a>


                <!-- NIGHTWEAR -->

                <a asp-controller="Products"
                   asp-action="Index"
                   asp-route-categoryId="6"
                   class="category-nav-link">

                    Nightwear

                </a>


            </nav>

        </div>

    </header>


    <!-- ============================= -->
    <!-- MAIN PAGE CONTENT -->
    <!-- ============================= -->

    <main role="main">

        @RenderBody()

    </main>


    <!-- ============================= -->
    <!-- FOOTER -->
    <!-- ============================= -->

    <footer class="fashion-footer">

        <div class="container">


            <!-- FOOTER BRAND -->

            <div class="footer-brand">

                SHEIN<span>|</span>STYLE

            </div>


            <p>
                Discover your style. Wear your confidence.
            </p>


            <!-- FOOTER LINKS -->

            <div class="footer-links">

                <a asp-controller="Home"
                   asp-action="Index">

                    Home

                </a>


                <a asp-controller="Products"
                   asp-action="Index">

                    Shop

                </a>


                <a asp-controller="Cart"
                   asp-action="Index">

                    Shopping Bag

                </a>


                <a asp-controller="Home"
                   asp-action="Privacy">

                    Privacy

                </a>

            </div>


            <hr />


            <!-- COPYRIGHT -->

            <small>

                &copy; @DateTime.Now.Year SHEIN Style Clone.

                Built as a fashion e-commerce project.

            </small>


        </div>

    </footer>


    <!-- ============================= -->
    <!-- JAVASCRIPT -->
    <!-- ============================= -->
    <!-- BOOTSTRAP JAVASCRIPT -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js">
    </script>


    <!-- JQUERY -->

    <script src="~/lib/jquery/dist/jquery.min.js">
    </script>


    <!-- SITE JAVASCRIPT -->

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>


    <!-- MEGA MENU JAVASCRIPT -->

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const menuContainer = document.querySelector(".mega-menu-container");

            const trigger = document.getElementById("megaMenuTrigger");


            // Check whether the menu exists

            if (!menuContainer || !trigger) {

                return;

            }


            // OPEN AND CLOSE MENU

            trigger.addEventListener("click", function (event) {

                event.stopPropagation();

                const isOpen = menuContainer.classList.toggle("is-open");

                trigger.setAttribute("aria-expanded", isOpen.toString());

            });


            // CLOSE MENU WHEN CLICKING OUTSIDE

            document.addEventListener("click", function (event) {

                if (!menuContainer.contains(event.target)) {

                    menuContainer.classList.remove("is-open");

                    trigger.setAttribute("aria-expanded", "false");

                }

            });


            // CLOSE MENU USING ESCAPE KEY

            document.addEventListener("keydown", function (event) {

                if (event.key === "Escape") {

                    menuContainer.classList.remove("is-open");

                    trigger.setAttribute("aria-expanded", "false");

                    trigger.focus();

                }

            });

        });

    </script>


    @await RenderSectionAsync("Scripts", required: false)


</body>

</html>
